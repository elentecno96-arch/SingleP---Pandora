    speakerName: "\uC9C0\uB098\uAC00\uB358 \uC0C1\uC778"
    dialogue: "\uB2F9\uC2E0 \uC5EC\uAE30\uAC00 \uC5B4\uB514\uC778\uC904 \uC54C\uC544?"
