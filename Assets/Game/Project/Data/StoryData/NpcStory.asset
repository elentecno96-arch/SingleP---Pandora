  - background: {fileID: 0}
    speakerName: "\uD310\uB3C4\uB77C"
    dialogue: "( \uC77C\uB2E8 \uB300\uCDA9 \uB458\uB7EC\uB300\uC790 )"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uD310\uB3C4\uB77C"
    dialogue: "\uC54C\uACE0 \uC788\uC8E0"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uC9C0\uB098\uAC00\uB294 \uC0C1\uC778"
    dialogue: "\uADF8\uB7EC\uBA74 \uC774\uC57C\uAE30\uAC00 \uBE60\uB974\uACA0\uAD70"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uC9C0\uB098\uAC00\uB294 \uC0C1\uC778"
    dialogue: "\uBCF4\uB2E4\uC2F6\uD788 \uB098\uB294 \uC0C1\uC778\uC774\uC57C\n\uC774\uACF3\uC744
      \uC9C0\uB098\uAC00\uB294\uAC70 \uBCF4\uB2C8 \uD0D1\uC73C\uB85C \uAC08\uAC70
      \uAC19\uC740\uB370"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uC9C0\uB098\uAC00\uB294 \uC0C1\uC778"
    dialogue: "\uC5B4\uB54C \uB0B4 \uBB3C\uAC74\uC744 \uD55C\uBC88 \uBCF4\uACA0\uB098?"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uD310\uB3C4\uB77C"
    dialogue: "\uC544\uC27D\uAC8C\uB3C4 \uC81C\uAC00 \uC218\uC911\uC5D0 \uACE8\uB4DC\uAC00
      \uC5C6\uC5B4\uC11C"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uC9C0\uB098\uAC00\uB294 \uC0C1\uC778"
    dialogue: "\uC544 \uBB50\uC57C \uC190\uB2D8\uC774 \uC544\uB2C8\uC600\uC796\uC544"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uC9C0\uB098\uAC00\uB294 \uC0C1\uC778"
    dialogue: "\uADF8\uB7EC\uBA74 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC774 \uD0D1\uC744
      \uAC04\uB2E4\uACE0?"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uC9C0\uB098\uAC00\uB294 \uC0C1\uC778"
    dialogue: "\uC774 \uC55E\uBD80\uD130\uB294 \uD0D1 \uCD08\uC785\uAD6C\uB77C\uC11C
      \uBAAC\uC2A4\uD130\uB4E4\uC774 \uB098\uC62C\uD150\uB370?"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uD310\uB3C4\uB77C"
    dialogue: "\uBAAC\uC2A4\uD130\uC694? "
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uC9C0\uB098\uAC00\uB294 \uC0C1\uC778"
    dialogue: "\uC544\uBB34\uAC83\uB3C4 \uBAA8\uB974\uACE0 \uC628\uAC74\uAC00?\n\uD0D1
      \uC785\uAD6C \uBD80\uD130\uB294 \uBF08\uB2E4\uADC0\uB4E4\uC774 \uB3CC\uC544\uB2E4\uB2CC\uB2E4\uACE0"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uD310\uB3C4\uB77C"
    dialogue: "( \uC774\uC804\uC5D0\uB294 \uBAAC\uC2A4\uD130\uB294 \uB9CE\uC774 \uC5C6\uC5C8\uB358\uAC70
      \uAC19\uC740\uB370 )"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uD310\uB3C4\uB77C"
    dialogue: "( \uD0D1\uC5D0 \uAC00\uBD10\uC57C \uD560\uAC70 \uAC19\uB2E4 )"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uD310\uB3C4\uB77C"
    dialogue: "\uC81C\uAC00 \uD0D1\uC744 \uAF2D \uAC00\uC57C\uD558\uB294 \uC0C1\uD669\uC778\uB370
      \uB3C4\uC6C0\uC744 \uBC1B\uC744 \uC218 \uC788\uC744\uAE4C\uC694?"
    leftPortrait: {fileID: 21300000, guid: 65619ae0879097042bba3cbadb822c4d, type: 3}
    rightPortrait: {fileID: 0}
    isLeftSpeaking: 0
  - background: {fileID: 0}
    speakerName: "\uC9C0\uB098\uAC00\uB294 \uC0C1\uC778"
    dialogue: "\uC9C0\uAE08 \uB0B4\uAC00 \uAC00\uC9C0\uACE0 \uC788\uB294 \uBB34\uAE30\uB77C\uACE4
      \uAE30\uCD08 \uB9C8\uBC95\uC11C \uBC16\uC5D0 \uC5C6\uB294\uAC78"
