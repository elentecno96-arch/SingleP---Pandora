  m_Script: {fileID: 11500000, guid: df20553058f2b294e8acdde0a54836a1, type: 3}
  m_Name: StoryData
  m_EditorClassIdentifier: 
  lines:
  - background: {fileID: 21300000, guid: 23ede582560998042864d61735cbcf9b, type: 3}
    speakerName: 
    dialogue: "\uC544\uC8FC \uC624\uB798\uC804 \uC138\uC0C1\uC774 \uD3C9\uD654\uB86D\uB358
      \uC2DC\uC808"
  - background: {fileID: 21300000, guid: 6e37e2a4e2e560345aed21cb198eaa2c, type: 3}
    speakerName: 
    dialogue: "\uB9C8\uBC95\uC5D0 \uB300\uD574 \uC5F0\uAD6C\uD558\uB358 \uC0AC\uB78C\uC774
      \uC788\uC5C8\uB2E4"
  - background: {fileID: 21300000, guid: 3c8c288afbf2e2547afbdc2184eaa289, type: 3}
    speakerName: 
    dialogue: "\uADF8\uC758 \uC774\uB984\uC740 \uD310\uB3C4\uB77C\n\uD310\uB3C4\uB77C\uC5D0\uAC8C\uB294
      \uB9C8\uBC95\uC744 \uAC19\uC774 \uC5F0\uAD6C\uD558\uB358 \uB3D9\uB8CC\uAC00
      \uC788\uC5C8\uB294\uB370\r\n"
  - background: {fileID: 21300000, guid: 39e8657b0857b0844a8ea99eef24549c, type: 3}
    speakerName: 
    dialogue: "\uADF8 \uB3D9\uB8CC\uB294 \uD310\uB3C4\uB77C\uC758 \uACBD\uACE0\uB97C
      \uBB34\uC2DC\uD558\uACE0,\n\uB9C8\uBC95\uC758 \uAE08\uAE30\uC778 \uC545\uB9C8\uACC4\uC57D\uC744
      \uD1B5\uD574 \uC138\uC0C1\uC5D0 \uC545\uB9C8\uB97C \uC18C\uD658\uD558\uAC8C
      \uB41C\uB2E4"
  - background: {fileID: 21300000, guid: 66c5254749e484b48ae6a6bc0a078323, type: 3}
    speakerName: 
    dialogue: "\uB3D9\uB8CC\uB294 \uC545\uB9C8\uC758 \uD1B5\uC81C\uB97C \uC774\uACA8\uB0B4\uC9C0
      \uBABB\uD558\uACE0\n \uADF8\uB300\uB85C \uC545\uB9C8\uB4E4\uC5D0\uAC8C \uC601\uD63C\uC744
      \uBE7C\uC557\uAE30\uAC8C \uB41C\uB2E4"
  - background: {fileID: 21300000, guid: 3aabfa5038313e140a43761c50a3594f, type: 3}
    speakerName: 
    dialogue: "\uD310\uB3C4\uB77C\uB294 \uC138\uC0C1\uC744 \uC704\uD611\uD558\uB294
      \uC545\uB9C8\uB4E4\uC744 \uBB3C\uB9AC\uCE58\uAE30 \uC704\uD574 \n\uBCF8\uC778\uC758
      \uC601\uD63C\uC744 \uB300\uAC00\uB85C \uBD09\uC778 \uB9C8\uBC95\uC744 \uC0AC\uC6A9\uD574
      \uC790\uC2E0\uC758 \uB9C8\uBC95\uC11C\uC5D0 \uBCF8\uC778\uACFC \uC545\uB9C8\uB4E4\uC744
      \uBD09\uC778\uD558\uAC8C \uB41C\uB2E4"
  - background: {fileID: 21300000, guid: 141a8163fb2d2e449a2d2860bff1a17b, type: 3}
    speakerName: 
    dialogue: "\uD310\uB3C4\uB77C\uB294 \uC545\uB9C8\uB4E4\uC744 \uBD09\uC778\uC5D0
      \uC131\uACF5\uD574\n\uC138\uC0C1\uC774 \uB2E4\uC2DC \uD3C9\uD654\uB85C\uC6CC
      \uC9C8\uAC70\uB77C \uC0DD\uAC01\uD588\uC2B5\uB2C8\uB2E4"
  - background: {fileID: 21300000, guid: dd2f9e42cc908574996a54e880bc16e7, type: 3}
    speakerName: 
    dialogue: "\uB77C\uACE0 \uC0DD\uAC01\uD588\uC9C0\uB9CC \uC5B4\uC9F8\uC11C\uC778\uC9C0
      \uD310\uB3C4\uB77C\uB294 \uBD80\uD65C\uD558\uAC8C \uB429\uB2C8\uB2E4"
